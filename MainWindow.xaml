<Window x:Class="ConstructoraAG_WPF_Listo.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Constructora AG - Control de Asistencias" Height="820" Width="1400" Background="{StaticResource ColorFondo}" FontFamily="Segoe UI">
<Window.Resources>
    <Style x:Key="TopNavButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#17324D"/>
        <Setter Property="BorderBrush" Value="#B8C7D6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EAF2F8"/>
                <Setter Property="BorderBrush" Value="#4E7EA8"/>
                <Setter Property="Foreground" Value="#0F3A63"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D7E6F3"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopTabStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="#EAF2F8"/>
        <Setter Property="Background" Value="#173A5E"/>
        <Setter Property="BorderBrush" Value="#315A83"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2D6EAD"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2D6EAD"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#24557F"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</Window.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="86"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Encabezado institucional -->
    <Border Grid.Row="0" Background="#102A43" BorderBrush="#0B1F33" BorderThickness="0,0,0,1">
        <Grid Margin="18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#7F8C99" BorderThickness="1" Padding="4" Width="86" Height="66" VerticalAlignment="Center">
                <Image Source="/Assets/LogoAG.jpeg" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="Constructora AG" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Control de Asistencias" Foreground="#BFD5E8" FontSize="13"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtUsuario" Foreground="#EAF2F8" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="Sistema de control de personal" Foreground="#8FB1CF" FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Menú HORIZONTAL por pestañas -->
    <Border Grid.Row="1" Background="#173A5E" BorderBrush="#0F2942" BorderThickness="0,0,0,1">
        <TabControl x:Name="TopMenuTabs"
                    TabStripPlacement="Top"
                    Background="#F3F6F9"
                    BorderThickness="0"
                    Padding="8,6,8,8">
            <TabItem Header="OPERACIÓN" Style="{StaticResource TopTabStyle}">
                <WrapPanel Margin="4,2,4,0">
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Dashboard" Tag="Dashboard" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Asistencia" Tag="Asistencia" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Asistencia semanal" Tag="AsistenciaSemanal" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Incidencias" Tag="Incidencias" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Historial respaldos" Tag="HistorialRespaldoAsistencia" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Personal sin alta" Tag="PersonalSinAlta" Click="Nav_Click" ToolTip="Empleados con checadas en los últimos 7 días que no figuran en dbo.Empleados."/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Historial de checadas" Tag="HistorialChecadas" Click="Nav_Click" ToolTip="Historial permanente y consolidado de checadas copiadas desde todas las bases activas."/>
                </WrapPanel>
            </TabItem>

            <TabItem Header="PERSONAL Y CATÁLOGOS" Style="{StaticResource TopTabStyle}">
                <WrapPanel Margin="4,2,4,0">
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Empleados" Tag="Empleados" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Rangos por ubicación" Tag="RangosEmpleado" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Catálogos" Tag="Catalogos" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Categorías empleados" Tag="CategoriasEmpleado" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Puestos por área" Tag="AreaPuestos" Click="Nav_Click"/>
                </WrapPanel>
            </TabItem>

            <TabItem Header="DISPOSITIVOS Y CONEXIONES" Style="{StaticResource TopTabStyle}">
                <WrapPanel Margin="4,2,4,0">
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Checadores ZK" Tag="ChecadoresZk" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Conexiones múltiples" Tag="Conexiones" Click="Nav_Click" ToolTip="Registrar, editar, probar, activar y definir la base administrativa."/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Usuarios de checadores" Tag="UsuariosChecadores" Click="Nav_Click"/>
                </WrapPanel>
            </TabItem>

            <TabItem Header="NÓMINA Y JORNADA" Style="{StaticResource TopTabStyle}">
                <WrapPanel Margin="4,2,4,0">
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Nómina" Tag="Nomina" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Jornada laboral" Tag="JornadaLaboral" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Horarios empleados" Tag="HorariosEmpleados" Click="Nav_Click"/>
                </WrapPanel>
            </TabItem>

            <TabItem Header="ADMINISTRACIÓN" Style="{StaticResource TopTabStyle}">
                <WrapPanel Margin="4,2,4,0">
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Reportes por correo" Tag="ReportesCorreo" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Correos reporte actividad" Tag="ConfiguracionCorreoReporteActividad" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Envío reporte actividad" Tag="ReporteActividadEmpleados" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Bitácora" Tag="Bitacora" Click="Nav_Click"/>
                    <Button Style="{StaticResource TopNavButtonStyle}" Content="Configuración WhatsApp" Tag="ConfiguracionWhatsApp" Click="Nav_Click"/>
                </WrapPanel>
            </TabItem>
        </TabControl>
    </Border>

    <!-- Contenido de módulos -->
    <Grid Grid.Row="2" Margin="12" Background="{StaticResource ColorFondo}">
        <Border Background="{StaticResource ColorPanel}" BorderBrush="{StaticResource ColorBorde}" BorderThickness="1" Padding="6">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Grid>
</Window>
