<Application x:Class="ConstructoraAG_WPF_Listo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <!-- Tema corporativo congruente: azul marino, slate y acento azul -->
        <SolidColorBrush x:Key="ColorFondo" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="ColorMenu" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="ColorPanel" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="ColorPanelAlt" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="ColorAcento" Color="#2F63A7"/>
        <SolidColorBrush x:Key="ColorAcentoHover" Color="#244F88"/>
        <SolidColorBrush x:Key="ColorSeccion" Color="#174A84"/>
        <SolidColorBrush x:Key="ColorTexto" Color="#111111"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#404040"/>
        <SolidColorBrush x:Key="ColorBorde" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="ColorEntrada" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorEntradaAlt" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="ColorSeleccion" Color="#CCE0F7"/>
        <SolidColorBrush x:Key="ColorCampoFondo" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorComboFondo" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ColorComboFondoHover" Color="#DDEAF8"/>
        <SolidColorBrush x:Key="ColorCampoTexto" Color="#111111"/>
        <SolidColorBrush x:Key="ColorCampoBorde" Color="#777777"/>
        <SolidColorBrush x:Key="ColorCampoFoco" Color="#2F63A7"/>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ColorCampoTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorCampoBorde}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ColorCampoTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorCampoBorde}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorCampoBorde}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorCampoBorde}"/>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>



        <!-- Corrección global para texto negro en listas desplegables y calendarios -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="{StaticResource ColorCampoFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorCampoTexto}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ColorCampoTexto}"/>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="{StaticResource ColorComboFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorAcento}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="RowBackground" Value="{StaticResource ColorEntrada}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource ColorEntradaAlt}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource ColorBorde}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>

            <!-- Tablas amplias y legibles en todo el sistema. -->
            <Setter Property="MinColumnWidth" Value="125"/>
            <Setter Property="ColumnWidth" Value="Auto"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ColorAcento}"/>
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        </Style>
    </Application.Resources>
</Application>
